    {
      "file": "/workspace/research-user/DevProjects/video-motion-alignment/execution-20261022/innovation/feature_gain_field/components.py",
      "sha256": "ebf0c773a76c60115cfede12c8a6b7ad5eb937af548a068f5a947c65755c4042",
      "excerpts": [
        {
          "start": 37,
          "end": 74,
          "lines": [
            {
              "line": 37,
              "text": "    valid &= torch.isfinite(mass) & (mass > 0) & (mass <= 1)"
            },
            {
              "line": 38,
              "text": "    s, r, p, n = [torch.nan_to_num(x, nan=0., posinf=0., neginf=0.) for x in xs]"
            },
            {
              "line": 39,
              "text": "    m = torch.nan_to_num(mass.to(dtype), nan=0., posinf=0., neginf=0.).clamp(0, 1)"
            },
            {
              "line": 40,
              "text": "    e = s - r"
            },
            {
              "line": 41,
              "text": "    tangent = n - p"
            },
            {
              "line": 42,
              "text": "    scale = (s.square().mean(-1) + r.square().mean(-1)"
            },
            {
              "line": 43,
              "text": "             + p.square().mean(-1) + n.square().mean(-1)) / 4"
            },
            {
              "line": 44,
              "text": "    floor = torch.finfo(dtype).tiny"
            },
            {
              "line": 45,
              "text": "    if basis == \"centered\":"
            },
            {
              "line": 46,
              "text": "        t2 = tangent.square().sum(-1)"
            },
            {
              "line": 47,
              "text": "        projected = tangent * ((e * tangent).sum(-1) / t2.clamp_min(floor)).unsqueeze(-1)"
            },
            {
              "line": 48,
              "text": "        signal = t2 / same.shape[-1]"
            },
            {
              "line": 49,
              "text": "    else:"
            },
            {
              "line": 50,
              "text": "        # Ridge-stabilized 2x2 Gram inverse; this is an explicitly different ablation."
            },
            {
              "line": 51,
              "text": "        a, b = s - p, n - s"
            },
            {
              "line": 52,
              "text": "        aa, ab, bb = a.square().sum(-1), (a * b).sum(-1), b.square().sum(-1)"
            },
            {
              "line": 53,
              "text": "        reg = ridge * (aa + bb).clamp_min(floor)"
            },
            {
              "line": 54,
              "text": "        ga, gb = aa + reg, bb + reg"
            },
            {
              "line": 55,
              "text": "        ea, eb = (e * a).sum(-1), (e * b).sum(-1)"
            },
            {
              "line": 56,
              "text": "        det = (ga * gb - ab.square()).clamp_min(floor)"
            },
            {
              "line": 57,
              "text": "        x, y = (gb * ea - ab * eb) / det, (ga * eb - ab * ea) / det"
            },
            {
              "line": 58,
              "text": "        projected = a * x.unsqueeze(-1) + b * y.unsqueeze(-1)"
            },
            {
              "line": 59,
              "text": "        signal = (aa + bb) / same.shape[-1]"
            },
            {
              "line": 60,
              "text": "    valid &= signal > relative_signal_floor * scale.clamp_min(floor)"
            },
            {
              "line": 61,
              "text": "    valid &= torch.isfinite(projected).all(-1)"
            },
            {
              "line": 62,
              "text": "    d = m.unsqueeze(-1) * e"
            },
            {
              "line": 63,
              "text": "    dt = m.unsqueeze(-1) * projected"
            },
            {
              "line": 64,
              "text": "    dn = d - dt"
            },
            {
              "line": 65,
              "text": "    # Invalid probes are excluded from controller sufficient statistics. The"
            },
            {
              "line": 66,
              "text": "    # caller still keeps the original same-time path as its numerical fallback."
            },
            {
              "line": 67,
              "text": "    energies = {\"total_energy\": d.square().sum(-1),"
            },
            {
              "line": 68,
              "text": "                \"temporal_energy\": dt.square().sum(-1),"
            },
            {
              "line": 69,
              "text": "                \"complement_energy\": dn.square().sum(-1)}"
            },
            {
              "line": 70,
              "text": "    energies = {k: torch.where(valid, v, torch.zeros_like(v)) for k, v in energies.items()}"
            },
            {
              "line": 71,
              "text": "    return {**energies, \"valid\": valid, \"input_finite\": torch.stack(["
            },
            {
              "line": 72,
              "text": "        torch.isfinite(x).all(-1) for x in xs]).all(0) & torch.isfinite(mass),"
            },
            {
              "line": 73,
              "text": "        \"tangent_signal\": signal, \"feature_scale\": scale}"
            },
            {
              "line": 74,
              "text": ""
            }
          ]
        }
      ]
    },
    {
      "file": "/workspace/research-user/DevProjects/video-motion-alignment/execution-20261022/innovation/feature_gain_field/controller.py",
      "sha256": "b5d72b897ad918a282140bf98d9a62d36083a85d4935cd8e326839eddea06ce7",
      "excerpts": [
        {
          "start": 151,
          "end": 184,
          "lines": [
            {
              "line": 151,
              "text": "    usable=initialized&valid&(scale>tiny)&(scale>relative_floor*anchor_scale)"
            },
            {
              "line": 152,
              "text": "    vt=(a/scale.clamp_min(tiny))*(B0/anchor_scale)"
            },
            {
              "line": 153,
              "text": "    vn=(b/scale.clamp_min(tiny))*(A0/anchor_scale)"
            },
            {
              "line": 154,
              "text": "    total=(vt+vn).clamp_min(tiny);vt,vn=vt/total,vn/total"
            },
            {
              "line": 155,
              "text": "    c=vt+3*vn+prior_weight*(vt+vn)/2"
            },
            {
              "line": 156,
              "text": "    rhs=vt+prior_weight*.25*(vt+vn)/2"
            },
            {
              "line": 157,
              "text": "    alpha=torch.full((n,),.25,dtype=torch.float64)"
            },
            {
              "line": 158,
              "text": "    local_alpha=alpha.clone();local_alpha[usable]=(rhs[usable]/c[usable]).clamp(0,.5)"
            },
            {
              "line": 159,
              "text": "    edge_weights=torch.zeros(max(0,n-1),dtype=torch.float64)"
            },
            {
              "line": 160,
              "text": "    if n>1:"
            },
            {
              "line": 161,
              "text": "        spacings=coords[1:]-coords[:-1]"
            },
            {
              "line": 162,
              "text": "        edge_weights=torch.median(spacings)/spacings"
            },
            {
              "line": 163,
              "text": "        edge_weights*=usable[:-1]&usable[1:]"
            },
            {
              "line": 164,
              "text": "    segment_reports=[];solved=torch.zeros(n,dtype=torch.bool)"
            },
            {
              "line": 165,
              "text": "    for start,end in _runs(usable.tolist()):"
            },
            {
              "line": 166,
              "text": "        edges=smoothness*edge_weights[start:end-1]"
            },
            {
              "line": 167,
              "text": "        diagonal=c[start:end].clone()"
            },
            {
              "line": 168,
              "text": "        if end-start>1:"
            },
            {
              "line": 169,
              "text": "            diagonal[:-1]+=edges;diagonal[1:]+=edges"
            },
            {
              "line": 170,
              "text": "        solution,report=solve_box_tridiagonal(diagonal,-edges,rhs[start:end],max_iterations=solver_iterations)"
            },
            {
              "line": 171,
              "text": "        if report['converged']:"
            },
            {
              "line": 172,
              "text": "            alpha[start:end]=solution;solved[start:end]=True"
            },
            {
              "line": 173,
              "text": "        report.update(interval_half_open=[start,end],evidence_bins=end-start)"
            },
            {
              "line": 174,
              "text": "        segment_reports.append(report)"
            },
            {
              "line": 175,
              "text": "    next_state={'initialized':next_initialized.clone(),'anchor_temporal':A0.clone(),'anchor_complement':B0.clone(),"
            },
            {
              "line": 176,
              "text": "                'anchor_step':next_anchor_step.clone(),'last_step':step_index,'layer_index':layer_index,'settings':settings}"
            },
            {
              "line": 177,
              "text": "    return alpha,next_state,{"
            },
            {
              "line": 178,
              "text": "        'alpha':alpha.clone(),'unsmoothed_alpha':local_alpha,'temporal_energy':a,'complement_energy':b,"
            },
            {
              "line": 179,
              "text": "        'valid_probe_count':torch.where(torch.isfinite(count)&(count>0),count,torch.zeros_like(count)),"
            },
            {
              "line": 180,
              "text": "        'anchor_created':created,'initialized':next_initialized.clone(),'anchor_step':next_anchor_step.clone(),"
            },
            {
              "line": 181,
              "text": "        'anchor_temporal':A0.clone(),'anchor_complement':B0.clone(),"
            },
            {
              "line": 182,
              "text": "        'usable_evidence':usable,'solver_succeeded':solved,'fallback_to_prior':~solved,"
            },
            {
              "line": 183,
              "text": "        'normalized_temporal':vt,'normalized_complement':vn,'quadratic_diagonal':c,'quadratic_rhs':rhs,"
            },
            {
              "line": 184,
              "text": "        'edge_weights':edge_weights,'segments':segment_reports,'prior_weight':prior_weight,'smoothness':smoothness,"
            }
          ]
        },
        {
          "start": 190,
          "end": 186,
          "lines": []
        }
      ]
    }
