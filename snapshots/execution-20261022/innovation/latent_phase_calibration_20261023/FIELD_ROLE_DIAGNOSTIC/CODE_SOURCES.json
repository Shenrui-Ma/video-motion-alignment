  "sources": [
    {
      "file": "/workspace/research-user/DevProjects/video-motion-alignment/execution-20261022/innovation/feature_gain_field/attention.py",
      "sha256": "01c325199e4229eb1d1a1580663dabe60476766ce9ad7bd36c045a06b9a96a08",
      "excerpts": [
        {
          "start": 83,
          "end": 132,
          "lines": [
            {
              "line": 83,
              "text": "    # Energy is measured at full resolution, before W_o, for each video bin."
            },
            {
              "line": 84,
              "text": "    correction_view=correction.reshape(1,heads,t,s,d)"
            },
            {
              "line": 85,
              "text": "    bin_energy=torch.linalg.vector_norm(correction_view,dim=(0,1,3,4)).square()"
            },
            {
              "line": 86,
              "text": "    alpha=torch.full((t,),config.alpha_prior,device=q.device,dtype=dtype)"
            },
            {
              "line": 87,
              "text": "    control={}"
            },
            {
              "line": 88,
              "text": "    if config.mode!='fixed':"
            },
            {
              "line": 89,
              "text": "        # Fixed stratified probes cover each spatial frame; all attention heads"
            },
            {
              "line": 90,
              "text": "        # participate. No QK probability grid or intermediate RGB is needed."
            },
            {
              "line": 91,
              "text": "        ids=torch.linspace(0,s-1,min(s,config.probes),device=q.device).round().long()"
            },
            {
              "line": 92,
              "text": "        indices=(torch.arange(t,device=q.device)[:,None]*s+ids[None,:]).flatten()"
            },
            {
              "line": 93,
              "text": "        nprobe=len(ids)"
            },
            {
              "line": 94,
              "text": "        probeq=qe.index_select(2,indices).reshape(heads,t,nprobe,d).permute(1,0,2,3).contiguous()"
            },
            {
              "line": 95,
              "text": "        bins=torch.arange(lo,hi,device=q.device);nt=(rb-ra)//s"
            },
            {
              "line": 96,
              "text": "        grouped_k=kr[0].reshape(heads,nt,s,d).permute(1,0,2,3)"
            },
            {
              "line": 97,
              "text": "        grouped_v=vr[0].reshape(heads,nt,s,d).permute(1,0,2,3)"
            },
            {
              "line": 98,
              "text": "        def neighbor(idx):"
            },
            {
              "line": 99,
              "text": "            a,_=counted(probeq,grouped_k[idx].contiguous(),grouped_v[idx].contiguous())"
            },
            {
              "line": 100,
              "text": "            return a.permute(1,0,2,3)"
            },
            {
              "line": 101,
              "text": "        # The configured valid window can end before padded reference bins."
            },
            {
              "line": 102,
              "text": "        # Keep the tangent inside that window rather than observing padding."
            },
            {
              "line": 103,
              "text": "        previous=neighbor((bins-1).clamp_min(lo));following=neighbor((bins+1).clamp_max(hi-1))"
            },
            {
              "line": 104,
              "text": "        sp=same.index_select(2,indices).reshape(heads,t,nprobe,d)"
            },
            {
              "line": 105,
              "text": "        rp=ref.index_select(2,indices).reshape(heads,t,nprobe,d)"
            },
            {
              "line": 106,
              "text": "        mp=mass.index_select(2,indices).reshape(heads,t,nprobe).clone()"
            },
            {
              "line": 107,
              "text": "        # A one-sided endpoint tangent contains S_same itself, biasing its"
            },
            {
              "line": 108,
              "text": "        # projection energy upward. Estimate alpha only from interior bins;"
            },
            {
              "line": 109,
              "text": "        # Endpoints keep the fixed prior; no smoothing edge crosses them."
            },
            {
              "line": 110,
              "text": "        mp[:,0,:]=0"
            },
            {
              "line": 111,
              "text": "        mp[:,-1,:]=0"
            },
            {
              "line": 112,
              "text": "        started=time.perf_counter()"
            },
            {
              "line": 113,
              "text": "        components=temporal_components(sp,rp,previous,following,mp,"
            },
            {
              "line": 114,
              "text": "            basis='centered',relative_signal_floor=config.relative_floor)"
            },
            {
              "line": 115,
              "text": "        aa,bb,nn=summarize_probe_components(components)"
            },
            {
              "line": 116,
              "text": "        transfer_started=time.perf_counter()"
            },
            {
              "line": 117,
              "text": "        # One explicit small device-to-host transfer of 3 x T sufficient stats."
            },
            {
              "line": 118,
              "text": "        # This may synchronize the current stream; report it separately."
            },
            {
              "line": 119,
              "text": "        cpu_stats=torch.stack((aa,bb,nn.to(aa.dtype))).to(device='cpu',dtype=torch.float64)"
            },
            {
              "line": 120,
              "text": "        record['statistics_transfer_seconds']=time.perf_counter()-transfer_started"
            },
            {
              "line": 121,
              "text": "        solver_started=time.perf_counter()"
            },
            {
              "line": 122,
              "text": "        value,next_state,control=update_gain_field(cpu_stats[0],cpu_stats[1],cpu_stats[2],"
            },
            {
              "line": 123,
              "text": "            state=controller_state,step_index=step_index,layer_index=layer_index,"
            },
            {
              "line": 124,
              "text": "            prior_weight=config.prior_weight,smoothness=config.smoothness,"
            },
            {
              "line": 125,
              "text": "            relative_floor=config.relative_floor,"
            },
            {
              "line": 126,
              "text": "            bin_coordinates=torch.arange(lo,hi,dtype=torch.float64))"
            },
            {
              "line": 127,
              "text": "        record['controller_cpu_seconds']=time.perf_counter()-solver_started"
            },
            {
              "line": 128,
              "text": "        record['statistics_transfer_bytes']=cpu_stats.numel()*cpu_stats.element_size()"
            },
            {
              "line": 129,
              "text": "        # Per-bin gain is shared by every head and spatial token in that bin."
            },
            {
              "line": 130,
              "text": "        alpha=value.to(device=q.device,dtype=dtype)"
            },
            {
              "line": 131,
              "text": "        if controller_state_out is not None:"
            },
            {
              "line": 132,
              "text": "            controller_state_out['next_state']=next_state"
            }
          ]
        },
        {
          "start": 137,
          "end": 151,
          "lines": [
            {
              "line": 137,
              "text": "    applied_energy=(alpha.square()*bin_energy).sum()"
            },
            {
              "line": 138,
              "text": "    correction_view.mul_(alpha[None,None,:,None,None])"
            },
            {
              "line": 139,
              "text": "    correction.add_(full[:,:,qa:qb].to(dtype))"
            },
            {
              "line": 140,
              "text": "    changed=correction.to(full.dtype)"
            },
            {
              "line": 141,
              "text": "    finite=torch.isfinite(changed).all()"
            },
            {
              "line": 142,
              "text": "    full[:,:,qa:qb].copy_(changed)"
            },
            {
              "line": 143,
              "text": "    record.update(applied=True,alpha=alpha.detach(),control=control,"
            },
            {
              "line": 144,
              "text": "        head_energy=head_energy.detach(),bin_energy=bin_energy.detach(),"
            },
            {
              "line": 145,
              "text": "        latent_bin_indices=list(range(lo,hi)),reference_mass_mean=mass.mean().detach(),"
            },
            {
              "line": 146,
              "text": "        correction_energy=correction_energy.detach(),"
            },
            {
              "line": 147,
              "text": "        applied_energy=applied_energy.detach(),finite_output=finite.detach())"
            },
            {
              "line": 148,
              "text": "    if diagnostics is not None:diagnostics.update(record)"
            },
            {
              "line": 149,
              "text": "    return packed(full)"
            },
            {
              "line": 150,
              "text": ""
            },
            {
              "line": 151,
              "text": ""
            }
          ]
        }
      ]
