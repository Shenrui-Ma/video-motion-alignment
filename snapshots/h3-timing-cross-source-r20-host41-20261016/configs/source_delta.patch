+def gpu_readiness():
+    """Exact UUID query is mandatory; never fall back to an index after an error."""
+    result = subprocess.run(['nvidia-smi', '-i', GPU,
+        '--query-gpu=uuid,memory.used,memory.free,utilization.gpu,temperature.gpu',
